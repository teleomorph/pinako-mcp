# The dev-only @anthropic-ai/claude-agent-sdk (native-chat test harness) declares a
# peer dependency on zod@^4, while the Bridge runtime deps (@modelcontextprotocol/sdk
# + zod) sit on zod@3. npm 7+ treats that as an unresolvable ERESOLVE conflict and
# aborts — and because `npm ci` deletes node_modules BEFORE resolving, a failed run
# leaves the tree empty and the Bridge host dead at launch
# (ERR_MODULE_NOT_FOUND: @modelcontextprotocol/sdk).
#
# That is exactly what took the Bridge down 2026-07-19 → 07-24; see the dated entry
# in session-organizer-notes.md. The conflict is confined to a devDependency and
# never reaches shipped artifacts: setup/build.js bundles host.js with esbuild and
# wraps it with pkg, so released binaries carry their deps compiled in.
#
# Removing this line re-arms that failure mode. Drop it only once the zod-4 peer
# conflict is gone at the source (agent-sdk pinned to a zod-3-compatible release,
# or the harness retired).
legacy-peer-deps=true
